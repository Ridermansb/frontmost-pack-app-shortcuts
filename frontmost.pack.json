{
  "schemaVersion": 1,
  "id": "app-shortcuts",
  "name": "App shortcuts tip sheet",
  "description": "Shows a keyboard-shortcuts cheat sheet JSON for the frontmost app (Chrome + Cursor included as examples).",
  "author": "Frontmost Reactor",
  "license": "MIT",
  "homepage": "https://github.com/Ridermansb/frontmost-pack-app-shortcuts",

  "reactions": [
    {
      "kind": "ui",
      "name": "Shortcuts",
      "match": {
        "mode": "per-app",
        "appId": "com.google.Chrome",
        "appName": "Google Chrome"
      },
      "url": {
        "from": "file",
        "path": "apps/com.google.Chrome.json"
      }
    },
    {
      "kind": "ui",
      "name": "Shortcuts",
      "match": {
        "mode": "per-app",
        "appId": "com.todesktop.230313mzl4w4u92",
        "appName": "Cursor"
      },
      "url": {
        "from": "file",
        "path": "apps/com.todesktop.230313mzl4w4u92.json"
      }
    }
  ],

  "globals": [
    {
      "kind": "script",
      "name": "List shortcut files",
      "script": {
        "path": "scripts/resolve-shortcuts.sh"
      }
    }
  ],

  "assets": {
    "shortcutsDir": "apps",
    "naming": {
      "strategy": "app-id",
      "extension": ".json",
      "fallback": "apps/_default.json"
    }
  },

  "requires": {
    "appMinVersion": null,
    "platforms": ["darwin", "win32", "linux"]
  }
}
